# 首次启动时创建的管理员账户（密码至少 8 个字符）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码

# 服务配置
PORT=8080
DATA_DIR=./data
API_CONFIG_FILE=./config/sites.json
API_CONFIG_HOST_FILE=./config/sites.json
DEFAULT_API_CONFIG_FILE=./config/sites.example.json
API_CONFIG_STRICT=false
TRUST_PROXY=true
COOKIE_SECURE=auto
SESSION_IDLE_HOURS=168
SESSION_MAX_DAYS=30
DEBUG=false

# 代理请求配置
REQUEST_TIMEOUT=15000
MAX_RETRIES=2
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
BLOCKED_HOSTS=localhost,localhost.localdomain,0.0.0.0,::1

# 发布时优先填写 vX.Y.Z；没有 tag 时可填写提交哈希。
APP_VERSION=
GIT_COMMIT=
